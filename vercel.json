{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/data/:path*",
      "destination": "https://gta5-87g.pages.dev/data/:path*"
    },
    {
      "source": "/__chunks/:path*",
      "destination": "https://gta5-87g.pages.dev/__chunks/:path*"
    },
    {
      "source": "/b/:path*",
      "destination": "https://gta5-87g.pages.dev/b/:path*"
    }
  ]
}
